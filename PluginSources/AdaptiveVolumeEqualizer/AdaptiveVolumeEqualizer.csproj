<Project Sdk="Microsoft.NET.Sdk">

  <!-- Optional pre-compile project. Compiles the plugin into a DLL against the
       deployed TS3AudioBot/TSLib assemblies. Override BinDir to point at your
       actual runtime directory if it differs. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>AdaptiveVolumeEqualizerPlugin</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BinDir Condition="'$(BinDir)' == ''">$(MSBuildThisFileDirectory)../../TS3AudioBot/bin/Release/netcoreapp3.1</BinDir>
    <NoWarn>$(NoWarn);CS1701;CS1702;CS8632;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AdaptiveVolumeEqualizerPlugin.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TS3AudioBot">
      <HintPath>$(BinDir)/TS3AudioBot.dll</HintPath>
    </Reference>
    <Reference Include="TSLib">
      <HintPath>$(BinDir)/TSLib.dll</HintPath>
    </Reference>
    <Reference Include="NLog">
      <HintPath>$(BinDir)/NLog.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(BinDir)/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
